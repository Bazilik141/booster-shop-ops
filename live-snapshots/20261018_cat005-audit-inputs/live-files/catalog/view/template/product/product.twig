      <script>
      // R07MOB10 related carousel progress
      (function() {
        var related = document.querySelector('.bs-related');
        var track = document.querySelector('.bs-related__track');
        var thumb = document.querySelector('.bs-related__progress-thumb');

        if (!track || !thumb) {
          return;
        }

        function getCssVar(name, fallback) {
          var value = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
          return value || fallback;
        }

        function setCategoryColor() {
          var crumbs = Array.prototype.slice.call(document.querySelectorAll('.breadcrumb a')).map(function(anchor) {
            return [
              anchor.textContent || '',
              anchor.getAttribute('href') || '',
              anchor.href || ''
            ].join(' ');
          }).join(' ').toLowerCase();

          var color = getCssVar('--bs-blue', '#1E3A8A');

          if (crumbs.indexOf('one-piece') !== -1 || crumbs.indexOf('one piece') !== -1) {
            color = getCssVar('--bs-onepiece', '#1E40AF');
          }

          if (crumbs.indexOf('pokemon') !== -1 || crumbs.indexOf('pokémon') !== -1) {
            color = getCssVar('--bs-pokemon', '#C68A00');
          }

          (related || track).style.setProperty('--bs-related-progress-color', color);
        }

        function updateRelatedProgress() {
          var max = track.scrollWidth - track.clientWidth;
          var width = 100;
          var left = 0;

          if (max > 0 && track.scrollWidth > 0) {
            var progress = Math.max(0, Math.min(1, track.scrollLeft / max));
            width = Math.max(20, Math.min(46, (track.clientWidth / track.scrollWidth) * 100));
            left = progress * (100 - width);
          }

          thumb.style.width = width + '%';
          thumb.style.left = left + '%';
        }

        setCategoryColor();
        track.addEventListener('scroll', updateRelatedProgress, { passive: true });
        window.addEventListener('resize', updateRelatedProgress);
        window.requestAnimationFrame(updateRelatedProgress);
      })();
      </script>
