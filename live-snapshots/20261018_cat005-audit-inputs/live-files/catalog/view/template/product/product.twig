            wrap.setAttribute('data-ready', '1');

            function minQty() {
              return parseInt(input.getAttribute('min'), 10) || 1;
            }

            function clamp(value) {
              var next = parseInt(value, 10);
              var min = minQty();

              if (isNaN(next) || next < min) {
                next = min;
              }

              return next;
            }

            function publish() {
              input.dispatchEvent(new Event('input', { bubbles: true }));
              input.dispatchEvent(new Event('change', { bubbles: true }));
            }

            wrap.addEventListener('click', function(event) {
              var button = event.target.closest ? event.target.closest('[data-main-qty-act]') : null;

              if (!button) {
                return;
              }

              var current = clamp(input.value);
              input.value = button.getAttribute('data-main-qty-act') === 'inc' ? current + 1 : Math.max(minQty(), current - 1);
              publish();
            });

            input.addEventListener('change', function() {
              input.value = clamp(input.value);
            });
          })();
