      </div>

      <script>
      (function() {
        var bar = document.querySelector('.bs-sticky-atc');
        var mainCta = document.querySelector('[data-main-add-to-cart]');
        var mainQty = document.querySelector('#input-quantity');

        if (!bar || !mainCta) {
          return;
        }

        var stickyQty = bar.querySelector('.bs-qty__input');
        var stickyCta = bar.querySelector('[data-sticky-add-to-cart]');
        var minQty = stickyQty ? parseInt(stickyQty.getAttribute('min'), 10) || 1 : 1;
        var mobileQuery = window.matchMedia ? window.matchMedia('(max-width: 768px)') : null;

        function isMobile() {
          return !!mobileQuery && mobileQuery.matches;
        }

        function clampQty(value) {
          var next = parseInt(value, 10);

          if (isNaN(next) || next < minQty) {
            next = minQty;
          }

          return next;
        }

        function setStickyQty(value) {
          if (stickyQty) {
            stickyQty.value = clampQty(value);
          }
        }

        function syncStickyFromMain() {
          if (mainQty && stickyQty) {
            setStickyQty(mainQty.value);
          }
        }

        function syncMainFromSticky() {
          if (mainQty && stickyQty) {
            mainQty.value = clampQty(stickyQty.value);
          }
        }

        function setBarVisible(visible) {
          var shouldShow = visible && isMobile();
          bar.hidden = !shouldShow;
          document.body.classList.toggle('bs-sticky-atc-visible', shouldShow);
        }

        function isMainCtaVisible() {
          var rect = mainCta.getBoundingClientRect();
          var viewportHeight = window.innerHeight || document.documentElement.clientHeight;

          return rect.bottom > 0 && rect.top < viewportHeight;
        }

        function updateVisibility() {
          setBarVisible(!isMainCtaVisible());
        }

        syncStickyFromMain();
        updateVisibility();

        if ('IntersectionObserver' in window) {
          var observer = new IntersectionObserver(function(entries) {
            if (!entries.length) {
              updateVisibility();
              return;
            }

            setBarVisible(!entries[0].isIntersecting);
          }, {
            threshold: 0.01
          });

          observer.observe(mainCta);
        } else {
          window.addEventListener('scroll', updateVisibility, { passive: true });
        }

        window.addEventListener('resize', updateVisibility);

        if (mobileQuery) {
          if (typeof mobileQuery.addEventListener === 'function') {
            mobileQuery.addEventListener('change', updateVisibility);
          } else if (typeof mobileQuery.addListener === 'function') {
            mobileQuery.addListener(updateVisibility);
          }
        }

        if (mainQty) {
          mainQty.addEventListener('input', syncStickyFromMain);
          mainQty.addEventListener('change', syncStickyFromMain);
        }

        if (stickyQty) {
          stickyQty.addEventListener('input', function() {
            setStickyQty(stickyQty.value);
          });

          stickyQty.addEventListener('change', function() {
            setStickyQty(stickyQty.value);
          });
        }

        bar.addEventListener('click', function(event) {
          var button = event.target.closest ? event.target.closest('[data-act]') : null;

          if (!button || !stickyQty) {
            return;
          }

          var current = clampQty(stickyQty.value);
          stickyQty.value = button.getAttribute('data-act') === 'inc' ? current + 1 : Math.max(minQty, current - 1);
        });

        if (stickyCta) {
          stickyCta.addEventListener('click', function() {
            syncMainFromSticky();
            mainCta.click();
          });
        }
      })();
      </script>
