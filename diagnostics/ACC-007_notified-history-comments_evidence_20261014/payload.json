        {
          "before": "\t\t$query = $this->db->query(\"SELECT `oh`.`order_history_id`,`oh`.`order_status_id`,`oh`.`date_added` FROM `\" . DB_PREFIX . \"order_history` `oh` INNER JOIN `\" . DB_PREFIX . \"order` `o` ON (`o`.`order_id` = `oh`.`order_id`) WHERE `oh`.`order_id` = '\" . (int)$order_id . \"' AND \" . $this->publicOrderScope() . \" AND \" . Acc007OrderStatus::visibleSql('`oh`.`order_status_id`') . \" ORDER BY `oh`.`date_added` ASC, `oh`.`order_history_id` ASC LIMIT \" . $start . \",\" . $limit);",
          "after": "\t\t// ACC-007_NOTIFIED_HISTORY_COMMENTS_20261014: never select unnotified history comments.\n\t\t$query = $this->db->query(\"SELECT `oh`.`order_history_id`,`oh`.`order_status_id`,`oh`.`date_added`,CASE WHEN `oh`.`notify` = 1 THEN `oh`.`comment` ELSE '' END AS `bs_customer_comment` FROM `\" . DB_PREFIX . \"order_history` `oh` INNER JOIN `\" . DB_PREFIX . \"order` `o` ON (`o`.`order_id` = `oh`.`order_id`) WHERE `oh`.`order_id` = '\" . (int)$order_id . \"' AND \" . $this->publicOrderScope() . \" AND \" . Acc007OrderStatus::visibleSql('`oh`.`order_status_id`') . \" ORDER BY `oh`.`date_added` ASC, `oh`.`order_history_id` ASC LIMIT \" . $start . \",\" . $limit);",
          "count": 1
        }
      ]
    },
