+<script>
+// ACC006_VISUAL_WP1_20261028: reveal the current chip inside this page's nav (same as RD-18 orders).
+(function () {
+    function reveal() {
+        if (!window.matchMedia('(max-width: 991.98px)').matches) return;
+        var nav = document.querySelector('.bs-account-favorites .bs-account-nav--page');
+        var current = nav && nav.querySelector('[aria-current="page"]');
+        if (!current) return;
+        var parentBox = nav.getBoundingClientRect();
+        var currentBox = current.getBoundingClientRect();
+        nav.scrollLeft += currentBox.left - parentBox.left - (parentBox.width - currentBox.width) / 2;
+    }
+    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', reveal, {once:true});
+    else reveal();
+}());
+</script>
