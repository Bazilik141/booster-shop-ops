# Normalize all text files: store as LF in the repo, check out as LF.
# Stops phantom CRLF/LF diffs between Windows, the autosync helper, and tooling.
* text=auto eol=lf

# Windows-only scripts keep CRLF (they run on the owner's machine).
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.vbs text eol=crlf
3d-print/serhiy-local-server/distribution/*.txt text eol=crlf

# Shell scripts must stay LF.
*.sh text eol=lf

# Binary assets — never touch line endings.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.svg  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.tar  binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.eot  binary

# RD-25 WP1 reviewed artifact bytes: retain SHA256 seals and runner payload hashes.
patches/RD-25-WP1* -text
diagnostics/RD-25-WP1* -text
diagnostics/RD-25-WP1*/** -text
handoffs/handoff_RD-25-WP1-FIX* -text

# ACC-008 WP2 reviewed bytes: preserve runner seals and native evidence SHA ledgers.
patches/ACC-008* -text
diagnostics/ACC-008* -text whitespace=cr-at-eol
diagnostics/ACC-008*/** -text whitespace=cr-at-eol

# MONO-CHECKOUT-PRECHECK-20261020: preserve exact reviewed executable bytes.
patches/MONO-CHECKOUT-PRECHECK-20261020_recover-missing-order_20261020.php -text
diagnostics/MONO-CHECKOUT-PRECHECK-20261020_owner-run_20261020.ps1 -text whitespace=cr-at-eol
diagnostics/MONO-CHECKOUT-PRECHECK-20261020_independent-review_20261020.md -text whitespace=-blank-at-eol,cr-at-eol
